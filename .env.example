# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN CONFIG (GAGA-GPS)
# Instrucciones: Ejecuta 'cp .env.example .env' y edita los valores antes de iniciar.
# ==============================================================================

# --- 1. SEGURIDAD Y CREDENCIALES OBLIGATORIAS ---
# Cambia estos valores por cadenas largas y aleatorias en producción.
DB_PASSWORD=cambia_esta_contraseña
REDIS_PASSWORD=cambia_esta_contraseña
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
TELEMETRY_SHARED_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# --- 2. ENTORNO DE EJECUCIÓN ---
# Valores válidos: 'development' o 'production'. 
# 'production' exige estrictamente que los secretos anteriores estén configurados.
NODE_ENV=production

# --- 3. ADMINISTRADOR POR DEFECTO (OPCIONAL) ---
# Se crea solo en la primera inicialización si la base de datos está vacía.
# DEFAULT_ADMIN_EMAIL=admin@gaga.com
# DEFAULT_ADMIN_PASSWORD=admin

# --- 4. SESIONES Y CONFIGURACIÓN GENERAL (VALORES POR DEFECTO) ---
# Descomenta estas líneas únicamente si necesitas modificar los límites estándar.
# JWT_EXPIRES_IN=8h
# OPERATOR_JWT_EXPIRES_IN=30d
# OPERATOR_SESSION_MAX_IDLE_DAYS=7
# MAPS_DIR=maps
# NO cambiar este default en Docker/producción - el volumen maps_data está fijo en /app/maps
# (ver docker-compose.yml y el Dockerfile). Solo tiene sentido sobreescribirlo en tu .env local
# sin Docker, por ejemplo a "files/maps" para agrupar tus archivos locales de prueba.

# --- 4.1 FLOTAS GRANDES (OPCIONAL) ---
# DB_POOL_MAX por defecto es 20 (suficiente para pruebas/flotas chicas). Con ~300
# dispositivos reportando telemetría, sube este valor para dar más margen a ráfagas
# de conexiones simultáneas (ver README "Preparación para escalar").
# DB_POOL_MAX=40

# --- 5. FILTRO DE TELEMETRÍA Y CONTROL DE GLITCHES GPS (OPCIONAL) ---
# Parámetros adaptativos para mitigar saltos falsos de posición en la flota.
# POSITION_FILTER_TOLERANCE_FACTOR=1.8
# POSITION_FILTER_MIN_FLOOR_KMH=25
# POSITION_FILTER_ABSOLUTE_CEILING_KMH=120
# POSITION_FILTER_JITTER_RADIUS_M=5
# POSITION_FILTER_HISTORY_WINDOW=8
# POSITION_FILTER_MAX_CONSECUTIVE_REJECTS=3
