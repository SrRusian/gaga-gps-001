# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN CONFIG (GAGA-GPS)
# Instrucciones: Ejecuta 'cp .env.example .env' y edita los valores antes de iniciar.
# ==============================================================================

# --- 1. SEGURIDAD Y CREDENCIALES OBLIGATORIAS ---
# Cambia estos valores por cadenas largas y aleatorias en producción.
DB_PASSWORD=cambia_esta_contraseña
REDIS_PASSWORD=cambia_esta_contraseña
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Solo es el valor de arranque de una instalación nueva (tabla system_settings vacía). En cuanto
# el admin lo cambie una vez desde el panel (Sistema > Configuración global), ese valor queda
# guardado en Postgres y gana siempre sobre este .env en cada reinicio/rebuild futuro - este .env
# deja de tener efecto para ese entorno. No hace falta mantenerlos sincronizados después.
TELEMETRY_SHARED_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# --- 1.1 FIREBASE CLOUD MESSAGING (OPCIONAL - actualizacion remota instantanea) ---
# JSON completo de la cuenta de servicio de Firebase Admin (Configuracion del proyecto > Cuentas
# de servicio > Generar nueva clave privada), en una sola linea, entre comillas simples. Sin esto,
# "Actualizar ahora"/"Actualizar todos" del panel siguen funcionando solo por el socket - una
# tableta sin la app abierta/con sesion iniciada no recibe la señal instantanea hasta su siguiente
# revisión programada (2 AM).
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com", ...}'

# --- 2. ADMINISTRADOR POR DEFECTO (OPCIONAL) ---
# Se crea solo en la primera inicialización si la base de datos está vacía.
# DEFAULT_ADMIN_EMAIL=admin@gaga.com
# DEFAULT_ADMIN_PASSWORD=admin

# --- 3. SESIONES Y CONFIGURACIÓN GENERAL (VALORES POR DEFECTO) ---
# Descomenta estas líneas únicamente si necesitas modificar los límites estándar.
# JWT_EXPIRES_IN=8h
# OPERATOR_JWT_EXPIRES_IN=30d
# OPERATOR_SESSION_MAX_IDLE_DAYS=7
# MAPS_DIR no se define aquí - docker-compose.yml lo fija siempre en "maps" (el volumen maps_data
# está montado ahí), no hace falta ni tiene efecto configurarlo en este archivo.

# --- 3.1 FLOTAS GRANDES (OPCIONAL) ---
# DB_POOL_MAX por defecto es 20 (suficiente para pruebas/flotas chicas). Con ~300
# dispositivos reportando telemetría, sube este valor para dar más margen a ráfagas
# de conexiones simultáneas (ver README "Preparación para escalar").
# DB_POOL_MAX=40

# --- 4. FILTRO DE TELEMETRÍA Y CONTROL DE GLITCHES GPS (OPCIONAL) ---
# Parámetros adaptativos para mitigar saltos falsos de posición en la flota.
# POSITION_FILTER_TOLERANCE_FACTOR=1.8
# POSITION_FILTER_MIN_FLOOR_KMH=25
# POSITION_FILTER_ABSOLUTE_CEILING_KMH=120
# POSITION_FILTER_JITTER_RADIUS_M=5
# POSITION_FILTER_HISTORY_WINDOW=8
# POSITION_FILTER_MAX_CONSECUTIVE_REJECTS=3

# --- 5. APP ANDROID/OPERADOR (OPCIONAL - valores de fabrica al compilar el APK) ---
# Estos VITE_* se leen en tiempo de BUILD (Vite, ver web/vite.config.ts envDir) y quedan
# COMPILADOS DENTRO del bundle web que corre en la app - a diferencia del resto de este archivo
# (JWT_SECRET, DB_PASSWORD, etc, que nunca salen del proceso del backend), cualquiera con el .apk
# instalado puede extraer estos valores decompilando el bundle. Aceptar ese riesgo es parte de
# conectar directo a un caster NTRIP externo desde la tableta sin pasar por el backend propio -
# no son secretos de servidor, son configuracion de fabrica para no llenarla a mano en cada
# tableta nueva (ver applyDefaultProvisioning() en DeviceSettingsPanel.tsx). Sin definirlos, esos
# campos quedan vacios al activar "Modo Operador"/tocar "Restaurar valores por defecto" - hay que
# llenarlos a mano en la tableta, igual que ya pasa hoy con el mount point si se deja vacio aqui.
# VITE_OPERATOR_MODE_CODE=3009
# VITE_NTRIP_DEFAULT_NAME=Principal
# VITE_NTRIP_DEFAULT_HOST=ntrip.ejemplo.com
# VITE_NTRIP_DEFAULT_PORT=2101
# VITE_NTRIP_DEFAULT_VERSION=v2
# VITE_NTRIP_DEFAULT_USERNAME=usuario
# VITE_NTRIP_DEFAULT_PASSWORD=contraseña
# VITE_NTRIP_DEFAULT_MOUNTPOINT=
