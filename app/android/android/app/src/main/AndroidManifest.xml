<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ver res/xml/device_filter.xml - hace que Android otorgue el permiso de acceso USB
                 solo para los receptores RTK ya soportados, sin el dialogo de permiso repetido -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />

        </activity>

        <service
            android:name=".traccar.TraccarSenderService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- se dispara sola cuando termina una auto-actualizacion silenciosa (ver
                     update/AppUpdateManager.kt) - Android mata el proceso igual que en un reboot -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Actualizacion automatica sin Play Store - ver update/AppUpdateManager.kt. Ambos
             receivers solo se invocan con un Intent explicito (AlarmManager/PackageInstaller),
             nunca por un intent-filter implicito - exported=false a proposito. -->
        <receiver android:name=".update.UpdateCheckReceiver" android:enabled="true" android:exported="false" />
        <receiver android:name=".update.UpdateInstallReceiver" android:enabled="true" android:exported="false" />

        <!-- Notificacion push (FCM) - actualizacion remota instantanea sin importar pantalla/
             sesion, ni con la app cerrada. Solo aplica si google-services.json esta presente (ver
             el try/catch condicional en app/build.gradle) - inofensivo sin el. -->
        <service
            android:name=".update.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Suspension por perdida de corriente del vehiculo - ver power/PowerSuspendScheduler.kt.
             Solo se invoca con un Intent explicito (AlarmManager), nunca por intent-filter implicito. -->
        <receiver android:name=".power.PowerSuspendAlarmReceiver" android:enabled="true" android:exported="false" />

        <!-- Modo Kiosko - ver res/xml/device_admin_policies.xml y KioskManager.kt. Requiere que la
             app se aprovisione una sola vez como Device Owner (adb, ver app/android/README.md) -
             sin eso, este receiver existe pero nunca se activa. -->
        <receiver
            android:name=".kiosk.KioskAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- apagar/reencender WiFi durante la suspension por perdida de corriente (ver
         power/PowerSuspendAlarmReceiver.kt) - WifiManager.setWifiEnabled() esta bloqueado para
         apps normales desde Android 10, pero Device Owner esta exento de esa restriccion -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- ConnectivityManager.registerNetworkCallback() en AppUpdateManager.waitForNetwork() -
         confirma que WiFi ya tiene internet real (no solo el radio encendido) antes de revisar
         actualizaciones con la tableta suspendida por perdida de corriente -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ya no controla el mecanismo real de mock-location (eso lo decide Opciones de desarrollador
         desde Android 6), pero Android SIGUE usando que este permiso este declarado como filtro
         para decidir que apps mostrar en "Seleccionar app de ubicacion ficticia" - sin esto la app
         nunca aparece en esa lista, sin importar reinicios ni reinstalaciones limpias.
         tools:ignore="MockLocation": lint asume que esto es solo para debug/tests - aqui es real,
         el RTK corregido depende de mock-location tambien en release, no solo en pruebas. -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" tools:ignore="MockLocation" />
    <!-- para que el envio de posicion se retome solo si la tableta se reinicia por completo -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- actualizacion automatica sin Play Store (ver update/AppUpdateManager.kt) - la instalacion
         en si es silenciosa solo porque la app es Device Owner (PackageInstaller +
         INSTALL_REASON_POLICY); este permiso es defensivo, sin el algunas versiones/fabricantes
         de Android podrian mostrar la pantalla de confirmacion de instalacion igual -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- UpdateScheduler.kt necesita esto para AlarmManager.setExactAndAllowWhileIdle() - sin
         declararlo, Android 12+ lanza SecurityException en tiempo de ejecucion y tumbaba la app
         completa (crash real confirmado en hardware, ver UpdateScheduler.kt). Device Owner recibe
         este permiso otorgado automaticamente al instalar, sin dialogo - pero solo si esta
         declarado aqui. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- receptor RTK por Bluetooth (modulo HC-05 sobre SPP). El vinculado se hace en Ajustes de
         Android, la app solo abre el puerto contra un dispositivo YA vinculado - por eso no hace
         falta BLUETOOTH_SCAN ni descubrimiento. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

</manifest>
