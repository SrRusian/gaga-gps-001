{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // "dom" para poder tipar tests de codigo de frontend (ej. el marcador de vehiculo, que crea
    // elementos) - el entorno de ejecucion sigue siendo node, el DOM real se simula en el test
    "lib": ["ES2022", "DOM"]
  },
  "include": ["**/*.ts"]
}
