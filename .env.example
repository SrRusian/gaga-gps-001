# Configuración del stack GAGA-GPS (Docker Compose) — backend + las
# 3 UIs + PostgreSQL + Redis, todo en un solo comando. Un único
# archivo para todo entorno (desarrollo local con Docker o
# producción).
#
# Uso:
#   cp .env.example .env
#   # editar .env con tus valores
#   docker compose up -d --build
#
# docker compose carga automáticamente ./.env — no hace falta
# exportar nada a mano.

# ── Contraseñas de PostgreSQL y Redis ───────────────────────────
# Usa valores fuertes y únicos en producción.
DB_PASSWORD=cambia_esta_contraseña
REDIS_PASSWORD=cambia_esta_contraseña

# ── Entorno ──────────────────────────────────────────────────────
# "production" activa validaciones estrictas de seguridad — el
# backend no arranca si faltan JWT_SECRET o TELEMETRY_SHARED_SECRET.
# Usa "development" para trabajar localmente sin esas restricciones.
NODE_ENV=production

# ── JWT — firma los tokens de sesión del panel admin ────────────
# Obligatoria si NODE_ENV=production. Genera algo largo y aleatorio,
# p. ej.: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# ── Telemetría — clave compartida para /gps (protocolo OsmAnd) ──
# Obligatoria si NODE_ENV=production — mitiga que terceros inyecten
# posiciones falsas. Configúrala también en la "Server URL" de
# Traccar Client en cada tableta:
#   https://tu-servidor.com/gps?key=TELEMETRY_SHARED_SECRET
TELEMETRY_SHARED_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# ── Opcionales — descomenta solo si necesitas cambiar el default ──
# JWT_EXPIRES_IN=8h
# OPERATOR_JWT_EXPIRES_IN=30d
# OPERATOR_SESSION_MAX_IDLE_DAYS=7
# MAPS_DIR=maps
