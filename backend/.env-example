# Base de datos propia (sin Traccar)
DB_HOST=
DB_PORT=5432
DB_NAME=gaga_gps
DB_USER=gaga_app
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Token de la UI de operador (tableta fija en el vehículo) — vive
# mucho más que el del panel admin (JWT_EXPIRES_IN) para no forzar
# re-login constante durante un turno de varios días. La expiración
# real por inactividad la controla OPERATOR_SESSION_MAX_IDLE_DAYS,
# no este valor (ver heartbeat en ui-operator).
OPERATOR_JWT_EXPIRES_IN=30d

# Días de inactividad (sin heartbeat) tras los cuales se cierra
# automáticamente un turno de operador abandonado.
OPERATOR_SESSION_MAX_IDLE_DAYS=7

# Telemetría — clave compartida para /gps (protocolo OsmAnd).
# Obligatoria si NODE_ENV=production (el backend falla al arrancar
# si falta). Configúrala también en la "Server URL" de Traccar
# Client en cada tableta, p. ej.:
#   https://tu-servidor.com/gps?key=TELEMETRY_SHARED_SECRET
TELEMETRY_SHARED_SECRET=

# Servidor
PORT=3001
NODE_ENV=

# Mapas
MAPS_DIR=maps
