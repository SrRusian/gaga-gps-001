{
  "name": "gaga-gps-001",
  "private": true,
  "version": "1.0.0",
  "description": "GAGA-GPS - monorepo (backend + apps web + paquetes compartidos)",
  "workspaces": [
    "backend",
    "web",
    "web/packages/*",
    "app/android",
    "app/packages/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --project unit --config config/vitest.config.mts",
    "test:watch": "vitest --project unit --config config/vitest.config.mts",
    "lint": "eslint --config config/eslint.config.js .",
    "predev": "npm install && npm run build",
    "dev:backend": "docker compose up --build postgres redis gaga-backend",
    "dev:web-app": "wait-on -t 60000 http://localhost:3001/health && npm run dev --workspace=@gaga-gps/web-app",
    "dev": "concurrently -n backend,web-app -c blue,green \"npm run dev:backend\" \"npm run dev:web-app\"",
    "pretest:integration": "docker compose up -d postgres",
    "test:integration": "vitest run --project integration --config config/vitest.config.mts",
    "test:all": "npm test && npm run test:integration"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
